<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The planner's in-game add-ons, one DLL, a folder each:
      Surveys/             stations map the ore below them (kRPC "PlannerSurvey")
      Traffic/             Traffic Controller: flies routes and directs station traffic (kRPC "PlannerTraffic")
      Refueler/            moves fuel between a docked craft and the station's tanks
      KerbinResources/     Kerbin Resources: every kerbal's flights, the player's and the routes' (kRPC "PlannerCrew")
      (Dispatch, an idea)  will run routes by itself: loops, triggers, crew rotation
    kRPC loads it from GameData like its own services, so it needs kRPC installed.
    It also needs ModuleManager (a standalone mod, on CKAN): Traffic/TrafficPorts.cfg adds Traffic Controller's port and
    role settings to every docking port and command part.

    It builds against KSP's own DLLs, which aren't in the repo, so it isn't in KspFlightPlanner.sln and CI doesn't build it.
    Build:            dotnet build mod/KspFlightPlanner.AddOns -c Release
    Build + install:  dotnet build mod/KspFlightPlanner.AddOns -c Release -p:Install=true
    Other KSP folder: add -p:KspDir="C:\path\to\Kerbal Space Program"
  -->
  <PropertyGroup>
    <!-- KSP 1.12 runs on Unity 2019's Mono, which takes .NET Framework 4.x assemblies. -->
    <TargetFramework>net471</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>KspFlightPlanner.AddOns</AssemblyName>
    <RootNamespace>KspFlightPlanner</RootNamespace>
    <KspDir Condition="'$(KspDir)' == ''">E:\SteamLibrary\steamapps\common\Kerbal Space Program</KspDir>
    <KspManaged>$(KspDir)\KSP_x64_Data\Managed</KspManaged>
    <InstallDir>$(KspDir)\GameData\KspFlightPlanner\Plugins</InstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(KspManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(KspManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(KspManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(KspManaged)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(KspManaged)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(KspManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="KRPC.Core" HintPath="$(KspDir)\GameData\kRPC\KRPC.Core.dll" Private="false" />
  </ItemGroup>

  <Target Name="InstallIntoKsp" AfterTargets="Build" Condition="'$(Install)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(InstallDir)" />
    <Copy SourceFiles="Traffic/TrafficPorts.cfg" DestinationFolder="$(KspDir)\GameData\KspFlightPlanner" />
    <Copy SourceFiles="KerbinResources/KerbinResources.cfg" DestinationFolder="$(KspDir)\GameData\KspFlightPlanner" />
    <!-- Old names, from before the add-ons were renamed: left in place, KSP would load both DLLs (two of every kRPC service). -->
    <Delete Files="$(KspDir)\GameData\KspFlightPlanner\HaulerPorts.cfg;$(InstallDir)\KspFlightPlanner.Survey.dll" />
    <Message Importance="high" Text="Installed $(TargetFileName) into $(InstallDir) and TrafficPorts.cfg (needs ModuleManager). Restart KSP to load it." />
  </Target>

</Project>
