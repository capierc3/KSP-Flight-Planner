<UserControl x:Class="KspFlightPlanner.App.Views.FromHereView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,12">
            <!-- Where the craft is now -->
            <Border Padding="10,6" CornerRadius="4" Background="#14808080">
                <TextBlock Text="{Binding CraftText}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="I want to" Style="{StaticResource SectionHeader}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" />
            <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="To" VerticalAlignment="Center" Width="100" />
                <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" DisplayMemberPath="Name" MinWidth="120" HorizontalAlignment="Left" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding NeedsAltitude, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding AltitudeLabel}" VerticalAlignment="Center" Width="100" />
                <TextBlock DockPanel.Dock="Right" Text="km" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Text="{Binding AltitudeText, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />
            </DockPanel>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding NeedsSpot, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="Spot" VerticalAlignment="Center" Width="100" />
                    <ComboBox ItemsSource="{Binding Spots}" SelectedItem="{Binding SelectedSpot}" MinWidth="180" HorizontalAlignment="Left"
                              ToolTip="Landmarks from the KSP wiki, then flags, landed craft and KerbNet waypoints from your save. A landed craft or flag targeted in KSP is picked for you." />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Latitude, longitude" VerticalAlignment="Center" Width="100" TextWrapping="Wrap" />
                    <TextBox Text="{Binding LatitudeText, UpdateSourceTrigger=PropertyChanged}" Width="80" ToolTip="Degrees, north +" />
                    <TextBox Text="{Binding LongitudeText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="6,0,0,0" HorizontalAlignment="Left" ToolTip="Degrees, east +" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Lander TWR" VerticalAlignment="Center" Width="100" />
                    <TextBox Text="{Binding TwrText, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Left"
                             ToolTip="Thrust-to-weight ratio at this body's surface; sets the braking burn's length and gravity loss" />
                </DockPanel>
            </StackPanel>
            <TextBlock Text="{Binding ActionHint}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Button Content="Plan it" Command="{Binding PlanCommand}" HorizontalAlignment="Left" Padding="14,2" Margin="0,10,0,0"
                    ToolTip="Plan from the craft's orbit right now" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <!-- Ways of making the trip -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTripOptions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OptionsTitle}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding TripOptions}" SelectedItem="{Binding SelectedTrip}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- The burns -->
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasBurns, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Burns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DeltaV}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,1,0,2">
                                        <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Countdown, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BurnTime, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding NodeText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Send to KSP" Command="{Binding SendCommand}" Padding="12,2"
                            ToolTip="Add these as maneuver nodes on the craft you're flying (its own nodes stay)" />
                    <Button Content="Keep as a flight" Command="{Binding FlyCommand}" Padding="12,2" Margin="6,0,0,0"
                            ToolTip="Save these burns as a flight and open it in the Flight pane, to follow countdowns and drift" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
