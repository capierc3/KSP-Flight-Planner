<UserControl x:Class="KspFlightPlanner.App.Views.TransferWindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- The next window to each planet, soonest first; double-click (or Enter) opens it in the Transfer Planner. -->
    <DockPanel Margin="12,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Origins}" SelectedItem="{Binding Origin}" DisplayMemberPath="Name" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Clock}" Style="{StaticResource Note}" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Text="Finding windows…" Style="{StaticResource Note}" Margin="0,0,0,4"
                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0"
                   Text="Cheapest day to leave a low parking orbit, Δv to capture included. Double-click to plan it." />
        <ListBox x:Name="List" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2" ToolTip="Double-click to open this trip in the Transfer Planner">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Note}" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Note}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Countdown}" VerticalAlignment="Top" Margin="8,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
