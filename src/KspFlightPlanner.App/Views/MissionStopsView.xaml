<UserControl x:Class="KspFlightPlanner.App.Views.MissionStopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <!-- Borderless until hovered: the add row reads as part of the list, not a toolbar -->
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </UserControl.Resources>

    <!-- The mission's stops, in order, and route options -->
    <ScrollViewer Padding="12,10,0,10" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,18,0">
            <!-- The mission's name: what it's saved as and listed under in Saved missions -->
            <TextBlock Text="Mission name" Style="{StaticResource Label}" Margin="0,0,0,3" />
            <TextBox Text="{Binding MissionName, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="SemiBold"
                     ToolTip="Saved with File › Save Mission (Ctrl+S)" Margin="0,0,0,14" />

            <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Reverse" Command="{Binding ReverseStopsCommand}" Style="{StaticResource SmallButton}"
                            ToolTip="Flip the route (e.g. plan the trip home)" />
                    <Button Content="Fly this mission" Command="{Binding FlyMissionCommand}" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                            ToolTip="Fly it in Fly mode, stop by stop: each step is planned from your craft's real orbit when it gets there, and the steps after it from where it leaves you" />
                </StackPanel>
                <TextBlock Text="Stops" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Stops}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>

                            <!-- Dotted connector down to the next stop's number, as in a maps route -->
                            <Line Grid.Row="1" Grid.RowSpan="4" X1="0" X2="0" Y1="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Margin="10,4,0,4"
                                  Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="2" StrokeDashArray="0 2.5" StrokeDashCap="Round">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                            </Line>
                            <Border Width="22" Height="22" CornerRadius="11" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Number}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <DockPanel Grid.Column="1">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button Content="↑" Style="{StaticResource SmallButton}" ToolTip="Move up"
                                            Command="{Binding DataContext.MoveStopUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="↓" Style="{StaticResource SmallButton}" ToolTip="Move down"
                                            Command="{Binding DataContext.MoveStopDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="✕" Style="{StaticResource SmallButton}" ToolTip="Remove stop"
                                            Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValuePath="Key" SelectedValue="{Binding PickerKey}" DisplayMemberPath="Text" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <!-- An orbit stop's height and, after a launch or a trip from another body, its inclination: type a value or pick one -->
                                <StackPanel Margin="0,4,0,0">
                                    <DockPanel Visibility="{Binding IsOrbit, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Left" Text="Altitude" Style="{StaticResource Label}" VerticalAlignment="Center" Width="62" Margin="2,0,0,0" />
                                        <TextBox DockPanel.Dock="Left" Text="{Binding AltitudeKmText, UpdateSourceTrigger=LostFocus}" Width="52" FontSize="12"
                                                 KeyDown="AltitudeBox_KeyDown"
                                                 ToolTip="Any altitude: the stop becomes a circular orbit at that height, reached from the low orbit. Press Enter to apply." />
                                        <TextBlock DockPanel.Dock="Left" Text="km" Style="{StaticResource Note}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="3,0,4,0" />
                                        <ComboBox ItemsSource="{Binding AltitudePresets}" SelectedItem="{Binding SelectedAltitudePreset}" FontSize="12" Padding="6,4,0,4"
                                                  ToolTip="Low: the body's low orbit on the Δv map. Stationary: the orbit whose period matches the body's day, so it stays over one spot. Custom: the altitude typed in the box." />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AltitudeError}" Foreground="#EF5350" FontSize="12" TextWrapping="Wrap"
                                               Margin="2,2,0,0" Visibility="{Binding HasAltitudeError, Converter={StaticResource BoolToVisibility}}" />
                                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ShowsInclination, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock DockPanel.Dock="Left" Text="Inclination" Style="{StaticResource Label}" VerticalAlignment="Center" Width="62" Margin="2,0,0,0" />
                                        <TextBox DockPanel.Dock="Left" Text="{Binding InclinationText, UpdateSourceTrigger=LostFocus}" Width="52" FontSize="12"
                                                 KeyDown="AltitudeBox_KeyDown"
                                                 ToolTip="The orbit's inclination to the body's equator, 0° to 180°: 0° equatorial, 90° polar, 180° equatorial going the other way. After a launch, the launch flies straight into it (0° is due east, the Δv map's launch). Arriving from another body, a small burn on the way tilts the approach. Below 90° the orbit goes the way the body turns; above 90° it's retrograde. Press Enter to apply." />
                                        <TextBlock DockPanel.Dock="Left" Text="°" Style="{StaticResource Note}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="3,0,4,0" />
                                        <ComboBox ItemsSource="{Binding InclinationPresets}" SelectedItem="{Binding SelectedInclinationPreset}" FontSize="12" Padding="6,4,0,4"
                                                  ToolTip="Equatorial: due east (the Δv map's launch), or arriving however the trip comes in. Polar: over both poles. Retrograde: due west, against the body's spin. Custom: the inclination typed in the box." />
                                    </DockPanel>
                                    <TextBlock Text="{Binding InclinationNote}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="2,4,0,0"
                                               Visibility="{Binding ShowsInclinationNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Role}" Style="{StaticResource Note}" Margin="2,2,0,2" />
                            </StackPanel>
                            <Grid Grid.Row="2" Grid.Column="1">
                                <TextBox x:Name="NoteBox" Text="{Binding Note}" FontSize="12" />
                                <TextBlock Text="Note, e.g. dock at station, pick up Bob" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=NoteBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Tools of the leg arriving at this stop -->
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0">
                                <Button Content="Plan a transfer window for this leg" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0"
                                        Visibility="{Binding OffersTransfer, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.OpenTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="The leg here crosses between planets: pick its launch window in the Transfer Planner. Its ejection and capture burns replace the Δv map's." />
                                <Border Visibility="{Binding HasTransfer, Converter={StaticResource BoolToVisibility}}" Padding="8,5" CornerRadius="4"
                                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open" Style="{StaticResource SmallButton}" ToolTip="Show the window in the Transfer Planner"
                                                    Command="{Binding DataContext.OpenTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource SmallButton}" ToolTip="Back to the Δv map's values for this leg"
                                                    Command="{Binding DataContext.RemoveTransferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Transfer window" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding TransferText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button Content="Plan the rendezvous for this leg" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Visibility="{Binding OffersRendezvous, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.OpenRendezvousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="This stop is a placed craft: plan meeting it in the Rendezvous pane. Its burns replace the Δv map's orbital values for this leg." />
                                <Border Visibility="{Binding HasRendezvous, Converter={StaticResource BoolToVisibility}}" Padding="8,5" CornerRadius="4" Margin="0,4,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open" Style="{StaticResource SmallButton}" ToolTip="Show the plan in the Rendezvous pane"
                                                    Command="{Binding DataContext.OpenRendezvousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource SmallButton}" ToolTip="Back to the Δv map's values for this leg"
                                                    Command="{Binding DataContext.RemoveRendezvousCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Rendezvous" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding RendezvousText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button Content="Land at a spot" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Visibility="{Binding OffersLanding, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.AddLandingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        ToolTip="Pick where to land: a landmark, a flag or craft in your save, a KerbNet waypoint, or a latitude and longitude. On airless bodies its deorbit and braking burns replace the Δv map's landing value." />
                                <Border Visibility="{Binding HasLanding, Converter={StaticResource BoolToVisibility}}" Padding="8,5" CornerRadius="4" Margin="0,4,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="✕" Style="{StaticResource SmallButton}" ToolTip="Land anywhere: back to the Δv map's value for this leg"
                                                Command="{Binding DataContext.RemoveLandingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="Landing spot" FontWeight="SemiBold" FontSize="12" />
                                            <ComboBox ItemsSource="{Binding LandingTargets}" SelectedItem="{Binding SelectedTarget}" Margin="0,4,8,0" FontSize="12"
                                                      ToolTip="Landmarks from the KSP wiki, then flags, landed craft and KerbNet waypoints from your save. Type a position below for any other spot." />
                                            <Grid Margin="0,4,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                                    <TextBlock Text="Latitude °" Style="{StaticResource Note}" />
                                                    <TextBox Text="{Binding LatitudeText}" FontSize="12" ToolTip="North positive, −90 to 90" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                                    <TextBlock Text="Longitude °" Style="{StaticResource Note}" />
                                                    <TextBox Text="{Binding LongitudeText}" FontSize="12" ToolTip="East positive, −180 to 180" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Ground height (m)" Style="{StaticResource Note}" />
                                                    <TextBox Text="{Binding GroundHeightText}" FontSize="12" ToolTip="Height of the ground above the datum. Flags and landed craft know it; leave blank if unknown (0 m is assumed)." />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1">
                                                    <TextBlock Text="Lander TWR" Style="{StaticResource Note}" />
                                                    <TextBox Text="{Binding LanderTwrText}" FontSize="12" ToolTip="The lander's thrust-to-weight ratio at this body's surface. Lower TWR brakes longer and loses more to gravity." />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding LandingText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <Button Content="Fly this landing" HorizontalAlignment="Left" Padding="10,1" Margin="0,6,0,0" FontSize="12"
                                                    Command="{Binding DataContext.FlyLandingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Make it a flight in Fly mode: the deorbit, track and braking burns are planned from your lander's real orbit, timed to the body's rotation" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Visibility="{Binding HasDeploy, Converter={StaticResource BoolToVisibility}}" Padding="8,5" CornerRadius="4" Margin="0,4,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open" Style="{StaticResource SmallButton}" ToolTip="Show the deployment in Resonant Orbits"
                                                    Command="{Binding DataContext.OpenDeployCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource SmallButton}" ToolTip="Remove the deployment"
                                                    Command="{Binding DataContext.RemoveDeployCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Deploy constellation" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding DeployText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Adding to the route, like a maps "Add destination" row: one button whose menu adds a place on the map, or a leg
                 planned in a calculator from where the mission is -->
            <Button Style="{StaticResource FlatButton}" Click="FlyToButton_Click" HorizontalAlignment="Left" Padding="0,4,10,4">
                <Button.ToolTip>
                    <TextBlock><Run Text="Add where the mission goes next, after " /><Run Text="{Binding AddAfterText, Mode=OneWay}" /></TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fly to" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Command="{Binding AddStopCommand}">
                            <MenuItem.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Stop" FontWeight="SemiBold" />
                                    <TextBlock Text="A place on the &#916;v map (or click one on the map)" Style="{StaticResource Note}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding AddRendezvousCommand}">
                            <MenuItem.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Rendezvous" FontWeight="SemiBold" />
                                    <TextBlock Text="Meet crafts in orbit: relays, stations, debris" Style="{StaticResource Note}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding AddTransferCommand}">
                            <MenuItem.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Transfer" FontWeight="SemiBold" />
                                    <TextBlock Text="Fly to another planet in a launch window" Style="{StaticResource Note}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Command="{Binding AddDeployCommand}">
                            <MenuItem.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Deploy" FontWeight="SemiBold" />
                                    <TextBlock Text="Release a satellite constellation into an orbit" Style="{StaticResource Note}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <Separator />
                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Style="{StaticResource Note}" MaxWidth="260">
                                    <Run Text="Goes after " /><Run Text="{Binding AddAfterText, Mode=OneWay}" /><Run Text=". Rendezvous, Transfer and Deploy open their calculator: set it up there, then Add to mission." />
                                </TextBlock>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Aerobrake wherever possible" IsChecked="{Binding UseAerobraking}" />
            <CheckBox Content="Include worst-case plane changes" IsChecked="{Binding IncludePlaneChanges}" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
