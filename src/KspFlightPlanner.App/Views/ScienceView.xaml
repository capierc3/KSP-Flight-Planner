<UserControl x:Class="KspFlightPlanner.App.Views.ScienceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Tools › Science (docs/SCIENCE.md): what's still left to collect at a body, per biome and situation. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10" MinWidth="460">
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                       Visibility="{Binding NeedsCatalog, Converter={StaticResource BoolToVisibility}}"
                       Text="The game's experiment list, which parts run them and each body's science multipliers come from KSP once per save, through the planner's add-on. Connect to KSP and it fetches them on its own, or press the button." />
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                       Visibility="{Binding IsSandbox, Converter={StaticResource BoolToVisibility}}"
                       Text="This save is sandbox: it keeps no science, so everything shows as unclaimed." />
            <WrapPanel Margin="0,0,0,4">
                <Button Content="Fetch science data from KSP" Command="{Binding FetchCommand}" Margin="0,0,8,4"
                        Visibility="{Binding NeedsCatalog, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" Margin="0,0,0,6" />

            <Grid Margin="0,0,0,8" Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Vessel" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Vessels}" SelectedItem="{Binding Vessel}" Margin="0,2"
                          ToolTip="Vessels in the save that carry experiments; picking one moves the body to where it is" />
                <TextBlock Grid.Row="1" Text="Body" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bodies}" SelectedItem="{Binding Body}" Margin="0,2" />
                <TextBlock Grid.Row="2" Text="Experiment" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Experiments}" SelectedItem="{Binding Experiment}" Margin="0,2" />
            </Grid>

            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4" />

            <StackPanel Visibility="{Binding HasBest, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <TextBlock Text="Best places to scan" Style="{StaticResource SectionHeader}" Margin="0,8,0,4" />
                <ItemsControl ItemsSource="{Binding Best}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Where}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Experiments}" Style="{StaticResource Note}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="By biome" Style="{StaticResource SectionHeader}" Margin="0,8,0,4"
                       Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVisibility}}" />
            <!-- Header: situations. Each row's cells use the same one-row grid, so they line up under it. -->
            <Grid Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Biome" Style="{StaticResource Label}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,6,8,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2" Text="All" Style="{StaticResource Label}" HorizontalAlignment="Right" Margin="0,6,0,3" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Biome}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnywhere}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="ToolTip" Value="Experiments whose result doesn't depend on the biome here: one subject for the whole body in that situation" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Right" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pays}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Empty}" Value="True">
                                                                <Setter Property="ToolTip" Value="{x:Null}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="{Binding Total}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Note}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,0"
                       Visibility="{Binding HasCatalog, Converter={StaticResource BoolToVisibility}}"
                       Text="Each number is what one run of each experiment would earn there once recovered, after any copies already aboard a vessel come home. ✓: under 1 point to earn from another run. Hover a number for each experiment's share. Sending data home earns less." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
