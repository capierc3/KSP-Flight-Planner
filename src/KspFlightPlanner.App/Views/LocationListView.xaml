<UserControl x:Class="KspFlightPlanner.App.Views.LocationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Bodies and custom locations; the selected one opens in the Location document. -->
    <DockPanel Margin="12,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="＋ New location" Command="{Binding NewLocationCommand}" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,8"
                   Text="● built-in bodies (read only)   ◆ your custom locations (editable). Ordered by distance from the parent." />
        <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" Background="Transparent" BorderThickness="0" SelectedItemChanged="Tree_SelectedItemChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Note}" />
                        </StackPanel>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
