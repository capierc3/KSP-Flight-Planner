<UserControl x:Class="KspFlightPlanner.App.Views.CalculatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- Inputs for the calculator document looked at last (Transfer Planner, Rendezvous, Resonant Orbits), so the documents can give their
         room to results -->
    <ScrollViewer Padding="12,10,0,10" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,18,0">
            <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap"
                       Visibility="{Binding ShowsNoCalculator, Converter={StaticResource BoolToVisibility}}"
                       Text="Inputs for the Transfer Planner, Rendezvous, Resonant Orbits, Engine chart, CommNet planner or Power budget show here: whichever of them you looked at last." />

            <StackPanel DataContext="{Binding Transfer}"
                        Visibility="{Binding DataContext.ShowsTransferInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Transfer window" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding IsEditingLeg, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Set by the mission leg " /><Run Text="{Binding LegTitle, Mode=OneWay}" /><Run Text=". Only the date and landing can change here." />
                </TextBlock>

                <StackPanel IsEnabled="{Binding IsTripEditable}">
                    <TextBlock Text="System" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="From" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Origins}" SelectedItem="{Binding SelectedOrigin}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="To" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Parking orbit (km)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ParkingAltitudeText, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding IsParkingAltitudeEnabled}"
                                     ToolTip="Not used when leaving a custom location (you start in its orbit)" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Arrival orbit (km)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ArrivalAltitudeText, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding IsArrivalAltitudeEnabled}"
                                     ToolTip="Not used when going to a custom location (you match its orbit)" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Earliest departure" Style="{StaticResource Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Year" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding EarliestYear, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <TextBlock Grid.Column="3" Text="Day" Style="{StaticResource Label}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="4" Text="{Binding EarliestDay, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <Button Grid.Column="5" Content="Today" Command="{Binding UseGameDateCommand}" Margin="6,0,0,0" Padding="8,0"
                            ToolTip="Today's date in the game: live while connected to KSP, else when KSP last saved" />
                </Grid>

                <TextBlock Text="At destination" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding ArrivalModes}" SelectedItem="{Binding SelectedArrivalMode}" IsEnabled="{Binding IsTripEditable}" />
                <CheckBox Content="Include landing in budget" IsChecked="{Binding IncludeLanding}" Margin="0,8,0,0" />

                <CheckBox Content="Plan return trip" IsChecked="{Binding PlanReturn}" Margin="0,4,0,0" IsEnabled="{Binding IsTripEditable}"
                          ToolTip="For a mission, plan the trip home as its own leg" />
                <StackPanel Visibility="{Binding PlanReturn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StayLabel}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding MinimumStayDays, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="Arriving back at " /><Run Text="{Binding SelectedOrigin.Name, Mode=OneWay}" />
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding ReturnArrivalModes}" SelectedItem="{Binding ReturnArrivalMode}" />
                </StackPanel>
                <!-- Add the result to the mission, after its last stop -->
                <Border Visibility="{Binding ShowsAddToMission, Converter={StaticResource BoolToVisibility}}" Padding="10,8" CornerRadius="4" Margin="0,12,0,0"
                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding AddToMissionText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                        <Button Content="Add to mission" Command="{Binding AddToMissionCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,3" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DataContext="{Binding Resonant}"
                        Visibility="{Binding DataContext.ShowsResonantInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Resonant orbit" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding IsEditingLeg, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Set by the mission stop " /><Run Text="{Binding LegTitle, Mode=OneWay}" /><Run Text=". The body and orbit can't change here." />
                </TextBlock>

                <StackPanel IsEnabled="{Binding IsOrbitEditable}">
                    <TextBlock Text="System" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" />

                    <TextBlock Text="Celestial body" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Bodies}" SelectedItem="{Binding SelectedBody}" />
                </StackPanel>

                <TextBlock Text="Number of satellites" Style="{StaticResource Label}" />
                <TextBox Text="{Binding SatelliteCount, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Orbital altitude (m)" Style="{StaticResource Label}" />
                <TextBox Text="{Binding AltitudeText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOrbitEditable}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding IsOrbitEditable}">
                    <Button Content="Use synchronous" Command="{Binding UseSynchronousAltitudeCommand}" Margin="0,0,8,0" />
                    <Button Content="Use min. line-of-sight" Command="{Binding UseMinimumLineOfSightCommand}" />
                </StackPanel>

                <CheckBox Content="Dive orbit (release at apoapsis)" IsChecked="{Binding PreferDiveOrbit}" Margin="0,10,0,0" />
                <CheckBox Content="Occlusion modifiers (0.75 atm / 0.9 vacuum)" IsChecked="{Binding UseOcclusion}" Margin="0,4,0,0" />
                <CheckBox Content="Show line-of-sight links" IsChecked="{Binding ShowLineOfSight}" Margin="0,4,0,0" />
                <!-- Add the result to the mission, after its last stop -->
                <Border Visibility="{Binding ShowsAddToMission, Converter={StaticResource BoolToVisibility}}" Padding="10,8" CornerRadius="4" Margin="0,12,0,0"
                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding AddToMissionText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                        <Button Content="Add to mission" Command="{Binding AddToMissionCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,3" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="RendezvousInputs" DataContext="{Binding Rendezvous}"
                        Visibility="{Binding DataContext.ShowsRendezvousInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Rendezvous" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding IsEditingLeg, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Set by the mission leg " /><Run Text="{Binding LegTitle, Mode=OneWay}" /><Run Text=". The start and targets can't change here." />
                </TextBlock>

                <TextBlock Text="Start from" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel IsEnabled="{Binding IsRouteEditable}">
                <RadioButton Content="Where the mission is" IsChecked="{Binding PickMission}" GroupName="Start"
                             Visibility="{Binding HasMission, Converter={StaticResource BoolToVisibility}}"
                             ToolTip="Start where the mission is (its last stop), so the plan can be added to the mission" />
                <TextBlock Text="{Binding MissionStartText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="28,0,0,4"
                           Visibility="{Binding PickMission, Converter={StaticResource BoolToVisibility}}" />
                <RadioButton Content="Launch from the ground" IsChecked="{Binding PickLaunch}" GroupName="Start" Margin="0,2,0,0"
                             ToolTip="Lift off from the KSC, or from a landed craft, flag or waypoint on any body (a lander on the Mun meeting Mun Station)" />
                <RadioButton Content="A craft already in orbit" IsChecked="{Binding PickCraft}" GroupName="Start" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Live game: what's being flown and targeted in KSP. -->
                <StackPanel Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" IsEnabled="{Binding IsRouteEditable}">
                    <TextBlock Text="{Binding GameText}" Style="{StaticResource Note}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Use the craft I'm flying" Command="{Binding UseActiveVesselCommand}" Padding="8,2"
                                ToolTip="Start from the craft you're flying in KSP, on its live orbit (around another body, the Δv map's steps get it to the targets first)" />
                        <Button Content="Add KSP's target" Command="{Binding AddGameTargetCommand}" Padding="8,2" Margin="6,0,0,0"
                                ToolTip="Add the craft targeted in KSP as the next target (it must orbit the same body as the other targets)" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding StartFromLaunch, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="From" Style="{StaticResource Label}" Margin="0,4,0,0" />
                    <ComboBox ItemsSource="{Binding LaunchSpots}" SelectedItem="{Binding SelectedSpot}" IsEnabled="{Binding IsStartEditable}"
                              ToolTip="The KSC, or a landed craft, flag or KerbNet waypoint from your save. The targets must orbit the same body; the climb below starts from that body's usual values." />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Parking (km)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ParkingAltitudeText, UpdateSourceTrigger=PropertyChanged, Delay=400}" IsEnabled="{Binding IsStartEditable}"
                                     ToolTip="For a mission leg, the low orbit of the leg's launch step" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Climb (min)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding AscentMinutesText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     ToolTip="Minutes from lift-off until you're in the parking orbit" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Range (°)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding DownrangeText, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     ToolTip="How far around Kerbin from the pad you are when the parking orbit is complete" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                               Text="Tune climb time and downrange to your own ascents: note the time and how far around Kerbin you are when you circularize." />
                </StackPanel>

                <StackPanel Visibility="{Binding StartFromCraft, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Craft" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Crafts}" SelectedItem="{Binding SelectedChaser}" DisplayMemberPath="Title" IsEnabled="{Binding IsStartEditable}" />
                </StackPanel>

                <TextBlock Text="Targets, in order" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel IsEnabled="{Binding IsRouteEditable}">
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Remove" Padding="6,1" Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveTargetCommand, ElementName=RendezvousInputs}" CommandParameter="{Binding}" />
                                <Button DockPanel.Dock="Right" Content="↑" ToolTip="Visit earlier" Padding="6,1" Margin="4,0,0,0"
                                        Command="{Binding DataContext.MoveTargetUpCommand, ElementName=RendezvousInputs}" CommandParameter="{Binding}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <LineBreak /><Run Text="{Binding Detail, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddTargetCommand}" Margin="6,0,0,0" />
                    <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding TargetToAdd}" DisplayMemberPath="Title" />
                </DockPanel>
                </StackPanel>

                <!-- Planning from where the mission is: add the plan to the mission as one stop per craft. -->
                <Border Visibility="{Binding ShowsAddToMission, Converter={StaticResource BoolToVisibility}}" Padding="10,8" CornerRadius="4" Margin="0,10,0,0"
                        BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding AddToMissionText}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                        <Button Content="Add to mission" Command="{Binding AddToMissionCommand}" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,3"
                                ToolTip="Adds the stops before the mission's last stop, with this plan's burns in Legs &amp; phases and the Rocket totals" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Timing" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <CheckBox Content="Start from the game's current time" IsChecked="{Binding FollowSaveTime}" IsEnabled="{Binding IsRouteEditable}"
                          ToolTip="The live game time while connected to KSP, else the time KSP last saved" />
                <TextBlock Text="{Binding SaveTimeText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                <Grid Visibility="{Binding FollowSaveTime, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="First burn no sooner than (min)" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding LeadMinutes, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </Grid>
                <TextBlock Text="{Binding LeadNote}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FFB74D"
                           Visibility="{Binding HasLeadNote, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{Binding ManualStart, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Year" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Day" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding StartDay, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Time (h:mm)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Time at each target (min)" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding StayMinutes, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                             ToolTip="Repairs, refuelling, swapping parts… before heading to the next target" />
                </Grid>

                <StackPanel Visibility="{Binding IsStartEditable, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Afterwards" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <CheckBox Content="{Binding DeorbitLabel}" IsChecked="{Binding Deorbit}" />
                <Grid Visibility="{Binding Deorbit, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop periapsis to (km)" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" Text="{Binding DeorbitAltitudeText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Engine chart: the stage to size -->
            <StackPanel DataContext="{Binding EngineChart}"
                        Visibility="{Binding DataContext.ShowsEngineChartInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Engine chart" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="The stage to size: what it pushes, the Δv it gives and where it fires." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Payload (t)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding PayloadText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Payload"
                                 ToolTip="Everything above this stage: later stages, the probe or crew pod, the lander…" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Δv (m/s)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding DeltaVText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Delta-v"
                                 ToolTip="Vacuum Δv this stage must give (take it from the mission's phases or the Δv map)" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Fires" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Bodies}" SelectedItem="{Binding Body}" AutomationProperties.Name="Fires"
                                  ToolTip="In space: no air, TWR against Kerbin's gravity. On a body: its gravity and surface air (lifting off or landing)." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Least TWR" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding MinTwrText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Least TWR"
                                 ToolTip="With full tanks. About 1.3 or more to lift off; 0.3 to 0.5 is plenty in space" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Engines" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding MaxEnginesChoices}" SelectedItem="{Binding MaxEngines}" AutomationProperties.Name="Engines"
                                  ToolTip="The most engines of one kind on the stage" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Best is" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding Goal}" AutomationProperties.Name="Best is" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Parts" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding PartsChoices}" SelectedItem="{Binding PartsChoice}" AutomationProperties.Name="Parts"
                          ToolTip="Engines and tanks to choose from: what this save can build, or with your research plan, or everything" />
                <TextBlock Text="Chart shows" Style="{StaticResource Label}" Margin="0,8,0,0" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding PayloadRanges}" SelectedItem="{Binding PayloadRange}" AutomationProperties.Name="Payload range" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding DeltaVRanges}" SelectedItem="{Binding DeltaVRange}" AutomationProperties.Name="Delta-v range" />
                </Grid>
                <TextBlock Text="{Binding InputProblem}" Style="{StaticResource Note}" Foreground="#EF5350" Margin="0,6,0,0" />
            </StackPanel>

            <!-- CommNet planner: the craft's and the relay's antennas, and the game's settings -->
            <StackPanel DataContext="{Binding CommNet}"
                        Visibility="{Binding DataContext.ShowsCommNetInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="CommNet planner" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Text="Craft antennas" Style="{StaticResource Label}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding CraftAntennas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DataContext.AntennaChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          SelectedItem="{Binding Antenna}" AutomationProperties.Name="Antenna" />
                                <TextBox Grid.Column="1" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="4,0,0,0"
                                         AutomationProperties.Name="How many" ToolTip="How many of this antenna" />
                                <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0" Padding="8,4"
                                        ToolTip="Remove" AutomationProperties.Name="Remove antenna" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ Add antenna" Command="{Binding AddCraftAntennaCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add craft antenna" />
                <Button Content="{Binding UseDesignText}" Command="{Binding UseDesignCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                        ToolTip="Take the antennas from the design open in the Engineering document" />

                <TextBlock Text="Relay antennas" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,14,0,3" />
                <TextBlock Style="{StaticResource Note}" Margin="0,0,0,4"
                           Text="A relay satellite to pass the craft's signal on (only relay antennas count). Leave empty for none." />
                <ItemsControl ItemsSource="{Binding RelayAntennas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DataContext.AntennaChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          SelectedItem="{Binding Antenna}" AutomationProperties.Name="Antenna" />
                                <TextBox Grid.Column="1" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="4,0,0,0"
                                         AutomationProperties.Name="How many" ToolTip="How many of this antenna" />
                                <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0" Padding="8,4"
                                        ToolTip="Remove" AutomationProperties.Name="Remove antenna" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="＋ Add antenna" Command="{Binding AddRelayAntennaCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Add relay antenna" />

                <TextBlock Text="Antennas to choose from" Style="{StaticResource Label}" Margin="0,14,0,3" />
                <ComboBox ItemsSource="{Binding PartsChoices}" SelectedItem="{Binding PartsChoice}" AutomationProperties.Name="Antennas to choose from" />

                <TextBlock Text="Tracking station" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" AutomationProperties.Name="Tracking station" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Range ×" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding RangeModifierText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Range modifier"
                                 ToolTip="The game's Range Modifier (difficulty settings): scales every antenna" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Station power ×" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding DsnModifierText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="DSN modifier"
                                 ToolTip="The game's DSN Modifier (difficulty settings): scales the tracking station" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SaveSettingsText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Power budget: the craft's power parts, where it is, and what's switched on -->
            <StackPanel DataContext="{Binding PowerBudget}"
                        Visibility="{Binding DataContext.ShowsPowerBudgetInputs, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Power budget" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <TextBlock Text="Parts" Style="{StaticResource Label}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DataContext.PartChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          SelectedItem="{Binding Part}" AutomationProperties.Name="Power part" />
                                <TextBox Grid.Column="1" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="4,0,0,0"
                                         AutomationProperties.Name="How many" ToolTip="How many of this part" />
                                <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}" Margin="4,0,0,0" Padding="8,4"
                                        ToolTip="Remove" AutomationProperties.Name="Remove part" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ Add part" Command="{Binding AddPartCommand}" AutomationProperties.Name="Add power part" />
                    <Button Content="{Binding UseDesignText}" Command="{Binding UseDesignCommand}" Margin="6,0,0,0"
                            ToolTip="Take the power parts that stay to the end of the design open in the Engineering document" />
                </StackPanel>
                <TextBlock Text="Parts to choose from" Style="{StaticResource Label}" Margin="0,10,0,3" />
                <ComboBox ItemsSource="{Binding PartsChoices}" SelectedItem="{Binding PartsChoice}" AutomationProperties.Name="Power parts to choose from" />

                <TextBlock Text="Where" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,14,0,3" />
                <ComboBox ItemsSource="{Binding Bodies}" SelectedItem="{Binding Body}" DisplayMemberPath="Name" AutomationProperties.Name="Body" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <RadioButton Content="In orbit at (km)" IsChecked="{Binding InOrbit}" GroupName="PowerWhere" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Text="{Binding AltitudeText, UpdateSourceTrigger=PropertyChanged, Delay=300}" IsEnabled="{Binding InOrbit}"
                             AutomationProperties.Name="Orbit altitude" />
                </Grid>
                <RadioButton Content="On the surface" IsChecked="{Binding OnSurface}" GroupName="PowerWhere" Margin="0,4,0,0" />

                <TextBlock Text="Switched on" Style="{StaticResource Label}" FontWeight="SemiBold" Margin="0,14,0,3" />
                <ItemsControl ItemsSource="{Binding Loads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsOn}" ToolTip="{Binding Hint}" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="Run fuel cells when short" IsChecked="{Binding FuelCells}" Margin="0,6,0,0"
                          ToolTip="Fuel cells burn liquid fuel and oxidizer to cover what the panels and generators can't" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
