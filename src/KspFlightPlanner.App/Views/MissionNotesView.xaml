<UserControl x:Class="KspFlightPlanner.App.Views.MissionNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Free-form notes saved with the mission -->
    <DockPanel Margin="12,10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,6"
                   Text="Anything to remember for this mission: parts to bring, crew, what to check in game. Saved with the mission." />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
    </DockPanel>
</UserControl>
