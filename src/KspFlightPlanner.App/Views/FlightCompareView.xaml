<UserControl x:Class="KspFlightPlanner.App.Views.FlightCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KspFlightPlanner.App.Controls"
             xmlns:vm="clr-namespace:KspFlightPlanner.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <ItemsPanelTemplate x:Key="Across">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!-- One rocket's flights side by side: figures in a table, and laid over each other on charts. -->
    <ScrollViewer Padding="24,12,8,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Compare flights" FontSize="20" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Rocket" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Rockets}" SelectedItem="{Binding Rocket}" Width="220" AutomationProperties.Name="Rocket" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <StackPanel Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <!-- The table (scrolls sideways on its own when the window is narrow) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                            <TextBlock Text="Show" Width="56" Style="{StaticResource ColumnHeader}" />
                            <TextBlock Text="Launched" Width="200" Style="{StaticResource ColumnHeader}" />
                            <ItemsControl ItemsSource="{x:Static vm:FlightCompareViewModel.Columns}" ItemsPanel="{StaticResource Across}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Width="104" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Padding="0,0,8,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CompareRow}">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Width="56">
                                                <CheckBox IsChecked="{Binding IsShown}" MinWidth="0" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Launched, StringFormat='Show the flight launched {0}'}" />
                                                <Rectangle Width="12" Height="12" Fill="{Binding Swatch}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Launched}" Width="200" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource Across}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CompareCell}">
                                                        <TextBlock Text="{Binding Text}" Width="104" TextAlignment="Right" Padding="0,0,8,0" VerticalAlignment="Center"
                                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                            <Setter Property="Foreground" Value="#66BB6A" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- The flights laid over each other -->
                <TextBlock Text="Charts" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox ItemsSource="{x:Static vm:FlightReportViewModel.ChartKinds}" SelectedItem="{Binding ChartKind}" Width="170"
                              AutomationProperties.Name="Chart" />
                    <ComboBox ItemsSource="{x:Static vm:FlightCompareViewModel.RangeKinds}" SelectedItem="{Binding RangeKind}" Width="170" Margin="8,0,0,0"
                              AutomationProperties.Name="Part of the flight" />
                </StackPanel>
                <controls:LineChartView Data="{Binding Chart}" Height="320"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Colours match the table; untick a flight to hide it. The ascent and whole flight line up at launch, a landing at the moment it left orbit." />

                <StackPanel Visibility="{Binding HasAscentProfile, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Ascent profiles" Style="{StaticResource SectionHeader}" />
                    <controls:LineChartView Data="{Binding AscentProfile}" Height="260"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
