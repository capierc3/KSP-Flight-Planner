<UserControl x:Class="KspFlightPlanner.App.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KspFlightPlanner.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Label/value pairs; values are selectable so they can be copied. -->
        <DataTemplate x:Key="FactRow" DataType="{x:Type vm:Fact}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,0,16,0" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Padding="0" MinHeight="0" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Read-only body -->
        <DataTemplate DataType="{x:Type vm:BodyDetailViewModel}">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,0,16,16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="34" Height="34" Fill="{Binding Color}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0" Text="Built-in data — read only. Custom locations around this body can be edited." />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Stops on the Δv map" Style="{StaticResource SectionHeader}" />
                <Grid Opacity="0.6" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" /><ColumnDefinition Width="230" /><ColumnDefinition Width="180" />
                        <ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Stop" /><TextBlock Grid.Column="1" Text="Reached from" /><TextBlock Grid.Column="2" Text="Δv (either way)" />
                    <TextBlock Grid.Column="3" Text="Plane" /><TextBlock Grid.Column="4" Text="Aerobrake when" /><TextBlock Grid.Column="5" Text="Flight time" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MapStops}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#30808080" Padding="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="230" /><ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Stop}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding From}" TextWrapping="Wrap" Opacity="0.8" />
                                    <TextBlock Grid.Column="2" Text="{Binding DeltaV}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="{Binding PlaneChange}" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Grid.Column="4" Text="{Binding Aerobrake}" />
                                    <TextBlock Grid.Column="5" Text="{Binding FlightTime}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasCustomLocations, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Your custom locations here" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding CustomLocations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Left" Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource SmallButton}" Margin="0,0,10,0" />
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Summary, Mode=OneWay}" /></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{Binding Sources}" Style="{StaticResource Note}" Margin="0,18,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Editable custom location -->
        <DataTemplate DataType="{x:Type vm:CustomLocationEditorViewModel}">
            <Grid Margin="0,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.ColumnSpan="3">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="80" />
                        <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="26" FontWeight="Bold"><Run Text="◆ " Foreground="{Binding Body.Body.Color, Mode=OneWay}" /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                        <TextBlock Opacity="0.7" Text="Custom location — edit the values on the left; everything on the right is calculated from them." />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Error}" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />

                <!-- Inputs -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock Text="Orbit" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Orbiting" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Bodies}" SelectedItem="{Binding Body}" DisplayMemberPath="Name" />
                    <CheckBox Content="Elliptical orbit (separate periapsis and apoapsis)" IsChecked="{Binding IsElliptical}" Margin="0,10,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding PeriapsisLabel}" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding PeriapsisKm, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Visibility="{Binding IsElliptical, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Apoapsis altitude (km)" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding ApoapsisKm, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Inclination (°)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Inclination, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                               Text="Inclination is relative to the body's equator (for Kerbol: Kerbin's orbital plane). Altitudes are above the surface." />

                    <TextBlock Text="Description" Style="{StaticResource SectionHeader}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </StackPanel>

                <!-- Derived values -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Calculated" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Derived}" ItemTemplate="{StaticResource FactRow}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                               Text="How these are worked out: Math guide §4 (Hohmann), §4b (orbits around Kerbol), §4c (elliptical orbits), §14 (plane changes)." />
                </StackPanel>

                <!-- Images -->
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add images…" Command="{Binding AddImagesCommand}" VerticalAlignment="Center" />
                        <TextBlock Text="Images" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <TextBlock Text="{Binding ImagesHint}" Style="{StaticResource Note}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10" CornerRadius="4" BorderBrush="#30808080" BorderThickness="1" Padding="4">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail}" Height="160" Stretch="Uniform" Cursor="Hand"
                                               ToolTip="Click to view full size" MouseLeftButtonUp="Image_Click" />
                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}" ToolTip="Remove image"
                                                    Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="＋ New location" Command="{Binding NewLocationCommand}" />
                <TextBlock Text="Locations" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,8"
                       Text="● built-in bodies (read only)   ◆ your custom locations (editable). Ordered by distance from the parent." />
            <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" SelectedItemChanged="Tree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding Detail}" />
        </ScrollViewer>
    </Grid>
</UserControl>
