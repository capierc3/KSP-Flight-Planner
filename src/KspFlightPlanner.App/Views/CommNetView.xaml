<UserControl x:Class="KspFlightPlanner.App.Views.CommNetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KspFlightPlanner.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <!-- How far the craft's antennas reach, and whether it can talk home from each body; inputs in the Calculators pane. -->
    <ScrollViewer Padding="24,12,8,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="CommNet planner" FontSize="20" FontWeight="Bold" />
            <TextBlock Style="{StaticResource Note}" FontSize="13"
                       Text="How far your craft's antennas reach, and whether it can still talk home from each body. Antennas, the relay and the game's settings are in the Calculators pane." />

            <!-- Ranges -->
            <ItemsControl ItemsSource="{Binding Cards}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,10,10" Padding="14,8" CornerRadius="4" BorderThickness="1" Width="240"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Text="{Binding Range}" FontFamily="Cascadia Mono, Consolas" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Each body at its farthest -->
            <TextBlock Text="Talking home from each body" Style="{StaticResource SectionHeader}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Body" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Farthest" Style="{StaticResource ColumnHeader}" />
                <controls:RangeBarView Grid.Column="2" Height="16" Margin="0,0,16,0" Ticks="{Binding ScaleTicks}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}">
                    <Run Text="■" Foreground="#4E79A7" /><Run Text=" Craft signal" />
                </TextBlock>
                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Visibility="{Binding HasRelay, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="■" Foreground="#F28E2B" /><Run Text=" Relay signal" />
                </TextBlock>
            </Grid>
            <ItemsControl ItemsSource="{Binding Bodies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" MinWidth="260" />
                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Body}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Farthest}" Style="{StaticResource Mono}" />
                                <controls:RangeBarView Grid.Column="2" Height="18" Margin="0,0,16,0" Fraction="{Binding DistanceFraction}"
                                                       CraftMarker="{Binding CraftRangeFraction}" RelayMarker="{Binding RelayRangeFraction}"
                                                       Foreground="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding CraftSignal}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Setter Property="Foreground" Value="#66BB6A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CraftReaches}" Value="False">
                                                    <Setter Property="Foreground" Value="#EF5350" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding RelaySignal}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                            <Setter Property="Foreground" Value="#66BB6A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelayReaches}" Value="False">
                                                    <Setter Property="Foreground" Value="#EF5350" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                       Text="Grey bar: the body's farthest from home, on a log scale. Blue tick: how far the craft reaches the tracking station; orange: how far the relay does. Signal is what's left at that distance (100% close by, 50% at half the range). Planets and moons can also block the line of sight. How it's worked out: Math guide §7.7." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
