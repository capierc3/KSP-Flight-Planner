<UserControl x:Class="KspFlightPlanner.App.Views.RendezvousView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KspFlightPlanner.App"
             xmlns:controls="clr-namespace:KspFlightPlanner.App.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Label / value rows for exact node values -->
        <DataTemplate x:Key="ExactFact">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,1,12,1" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="0" MinHeight="0" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One burn (StepRow): number, title, Δv and time; then by-feel text or exact node values. -->
        <DataTemplate x:Key="StepTemplate">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}">
                        <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DeltaV}" Style="{StaticResource Value}" FontWeight="SemiBold" Margin="0" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,1,0,4">
                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Countdown, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Feel}" TextWrapping="Wrap"
                                   Visibility="{Binding DataContext.ShowFeel, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Exact}" ItemTemplate="{StaticResource ExactFact}"
                                      Visibility="{Binding DataContext.ShowExact, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="VerdictBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#99EF5350" />
            <Setter Property="Background" Value="#1FEF5350" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CapacityStatus}" Value="Comfortable">
                    <Setter Property="BorderBrush" Value="#9966BB6A" />
                    <Setter Property="Background" Value="#1F66BB6A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CapacityStatus}" Value="InsideMargin">
                    <Setter Property="BorderBrush" Value="#99FFB300" />
                    <Setter Property="Background" Value="#1FFFB300" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8,10,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="440" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="0.8*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- The plan -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16,12,8,12">
            <DockPanel>
                <!-- Planning a mission leg: where it starts and what it meets come from the leg -->
                <Border DockPanel.Dock="Top" Visibility="{Binding IsEditingLeg, Converter={StaticResource BoolToVisibility}}" Margin="0,0,18,10" Padding="10,8"
                        CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Rendezvous for the mission leg" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LegTitle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,6"
                                   Text="The plan shown is saved with the mission: change the start time or launch in Calculators, or the phasing orbit or porkchop point here, to plan it another way." />
                        <Button Content="Stop editing the leg" Command="{Binding StopEditingLegCommand}" HorizontalAlignment="Left" Padding="8,1"
                                ToolTip="Use the tab on its own again; the mission keeps this plan" />
                    </StackPanel>
                </Border>

                <!-- What's being planned; its inputs live in the Calculators pane -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,18,10">
                    <Button DockPanel.Dock="Right" Content="Change…" Padding="8,1" VerticalAlignment="Center"
                            Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Calculators}"
                            ToolTip="Edit the start, targets and timing in the Calculators pane" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="Launch from the KSC" FontWeight="SemiBold" Visibility="{Binding StartFromLaunch, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="{Binding StartFromCraft, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="From " /><Run Text="{Binding SelectedChaser.Title, Mode=OneWay, TargetNullValue='a craft in orbit'}" />
                        </TextBlock>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding Targets.Count, Mode=OneWay}" /><Run Text=" target(s)" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,0,18,8" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,18,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="By feel" IsChecked="{Binding ShowFeel}" GroupName="Mode" Margin="0,0,12,0"
                                     ToolTip="What to look for and which way to burn" />
                        <RadioButton Content="Exact nodes" IsChecked="{Binding ShowExact}" GroupName="Mode"
                                     ToolTip="Time and prograde / normal / radial values to type into a maneuver node" />
                    </StackPanel>
                    <TextBlock Text="Flight plan" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,18,6" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="Fly this plan" Command="{Binding FlyCommand}" Padding="12,2" VerticalAlignment="Top"
                            ToolTip="Open it on the Flight tab: send the burns to KSP as maneuver nodes and re-plan from your real orbit as you fly" />
                    <TextBlock Text="Flying it? Hand it to the Flight tab to send the burns to KSP." Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,18,4"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Note}" FontSize="13" Margin="0,8"
                                   Visibility="{Binding HasNoPlan, Converter={StaticResource BoolToVisibility}}" />

                        <!-- From a craft around another body: the Δv map's steps to the targets' body first -->
                        <StackPanel Visibility="{Binding HasApproach, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ApproachTitle}" Style="{StaticResource SectionHeader}" Margin="0,6,0,4" />
                            <TextBlock Text="{Binding ApproachText}" Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ApproachSteps}" ItemTemplate="{StaticResource StepTemplate}" />
                        </StackPanel>

                        <!-- Launch -->
                        <StackPanel Visibility="{Binding HasLaunch, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="When to launch" Style="{StaticResource SectionHeader}" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,4"
                                       Text="Pick a lift-off; the cheapest is chosen for you (ties go to the soonest arrival)." />
                            <ListBox ItemsSource="{Binding LaunchRows}" SelectedIndex="{Binding LaunchIndex}" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,1">
                                            <TextBlock Text="{Binding When}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ContentControl Content="{Binding LaunchStep}" ContentTemplate="{StaticResource StepTemplate}" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Legs -->
                        <ItemsControl ItemsSource="{Binding Legs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel Margin="0,18,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Style="{StaticResource Value}" FontWeight="SemiBold" Margin="0" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Guide}" Style="{StaticResource Note}" Margin="0,0,0,6" />
                                        <StackPanel Visibility="{Binding HasPhasingChoice, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4">
                                            <TextBlock Text="Getting into position" Style="{StaticResource Label}" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{Binding PhasingRows}" SelectedItem="{Binding SelectedPhasing}" DisplayMemberPath="Title" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" />
                                        <TextBlock Text="{Binding Arrival}" Style="{StaticResource Note}" Margin="28,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Deorbit -->
                        <StackPanel Visibility="{Binding HasDeorbit, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Deorbit" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                            <ContentControl Content="{Binding DeorbitStep}" ContentTemplate="{StaticResource StepTemplate}" />
                        </StackPanel>

                        <!-- Final approach: rules of thumb -->
                        <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Closing the last few kilometres" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource Note}" FontSize="12.5" LineHeight="19">
                                Navball in Target mode. Point at the target (purple ◎) and burn toward it, then keep the yellow prograde marker on it.
                                <LineBreak />• Closing speed: about a tenth of the distance per second at most — 1 km: ≤ 50 m/s, 500 m: ≤ 20 m/s, 100 m: ≤ 5 m/s, 20 m: ≤ 1 m/s.
                                <LineBreak />• Drifting off? Burn so the prograde marker sits on the target marker again (point a little past it, on the far side from prograde).
                                <LineBreak />• Too fast? Point at target-retrograde and slow to the speed for that distance.
                                <LineBreak />• Under 200 m switch to RCS; dock at 0.2–0.5 m/s, or stop within reach for EVA repairs.
                            </TextBlock>
                        </StackPanel>

                        <!-- Budget -->
                        <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Δv budget" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding BudgetLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel x:Name="Line" Margin="0,2">
                                            <DockPanel>
                                                <TextBlock x:Name="Amount" DockPanel.Dock="Right" Style="{StaticResource Value}"
                                                           Text="{Binding DeltaV, StringFormat='{}{0:N0} m/s', TargetNullValue='—'}" />
                                                <TextBlock x:Name="StageText" Text="{Binding Stage}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock x:Name="NoteText" Text="{Binding Note}" Style="{StaticResource Note}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter TargetName="Amount" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="StageText" Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="Line" Property="Margin" Value="0,8,0,2" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,6" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BudgetTotalText}" Style="{StaticResource Value}" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="Total" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Visibility="{Binding StartFromLaunch, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                <TextBlock Text="Check a saved design" Style="{StaticResource Label}" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding DesignChoices}" SelectedItem="{Binding SelectedDesign}" DisplayMemberPath="Title" />
                            </StackPanel>
                            <TextBlock Text="{Binding CapacityHint}" Style="{StaticResource Note}" Margin="0,4,0,0" />
                            <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="1" Style="{StaticResource VerdictBorder}"
                                    Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CapacityVerdict}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding CapacityLines}" ItemTemplate="{StaticResource ExactFact}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- One leg: its orbits from above, or the porkchop of its transfer -->
        <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PlotLegs}" SelectedItem="{Binding SelectedPlotLeg}" DisplayMemberPath="Title"
                              MinWidth="160" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Orbits" IsChecked="{Binding ShowDiagram}" GroupName="RightPanel" Margin="0,0,12,0"
                                     ToolTip="The leg seen from above: orbits, transfer and numbered burns" />
                        <RadioButton Content="Transfer options" IsChecked="{Binding ShowPorkchop}" GroupName="RightPanel"
                                     ToolTip="Porkchop plot: pick another burn time and flight time" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <!-- Orbit diagram -->
                    <Grid Visibility="{Binding ShowDiagram, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}"
                                   Text="Looking down on the target's orbit, which runs anticlockwise; you meet at the top. Numbered dots are the burns in the flight plan." />
                        <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <controls:RendezvousDiagram Body="{Binding DiagramBody}" Leg="{Binding SelectedLegPlan}" FirstStep="{Binding DiagramFirstStep}" />
                                <TextBlock Text="{Binding PlotNote}" Foreground="#E6E9F0" TextWrapping="Wrap" FontSize="14" Margin="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Porkchop -->
                    <Grid Visibility="{Binding ShowPorkchop, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,8" Visibility="{Binding HasPlot, Converter={StaticResource BoolToVisibility}}">
                            <Button DockPanel.Dock="Right" Content="Back to best" Command="{Binding ResetInterceptCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding IsCustomIntercept, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Note}">
                                Transfer + match Δv by burn time (→) and flight time (↑). Blue is cheap, red is expensive
                                (<Run Text="{Binding PorkchopScaleLabel, Mode=OneWay}" />); dark gaps are 180° transfers, which can't be solved.
                                Click or drag to fly another one — later legs move with it.
                            </TextBlock>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,0,6,0">
                            <TextBlock Text="{Binding PorkchopMaxFlightLabel}" VerticalAlignment="Top" Style="{StaticResource Note}" />
                            <TextBlock Text="Flight time" VerticalAlignment="Center" Style="{StaticResource Note}">
                                <TextBlock.LayoutTransform><RotateTransform Angle="-90" /></TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock Text="{Binding PorkchopMinFlightLabel}" VerticalAlignment="Bottom" Style="{StaticResource Note}" />
                        </Grid>

                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <controls:PorkchopPlotView x:Name="Porkchop" Plot="{Binding CurrentPlot}" Selected="{Binding CurrentPlotSelection}" Cursor="Cross" />
                                <TextBlock Text="{Binding PlotNote}" Foreground="#E6E9F0" TextWrapping="Wrap" FontSize="14" Margin="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PorkchopStartLabel}" HorizontalAlignment="Left" Style="{StaticResource Note}" />
                            <TextBlock Text="{Binding PorkchopEndLabel}" HorizontalAlignment="Right" Style="{StaticResource Note}" />
                        </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
