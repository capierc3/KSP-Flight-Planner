<UserControl x:Class="KspFlightPlanner.App.Views.TechTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- A tech node: green researched, blue planned, outlined if it can be researched now, dim if it needs earlier nodes. -->
        <Style x:Key="NodeButton" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="ToolTip" Value="{Binding StatusText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" CornerRadius="5" BorderThickness="1.5" Padding="6,3"
                                Background="#1A2233" BorderBrush="#3A4560">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="#CFD8DC" FontSize="11.5" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CostText" Foreground="#90A4AE" FontSize="10.5">
                                    <Run Text="{Binding CostText, Mode=OneWay}" /><Run Text=" science" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Researched">
                                <Setter TargetName="Box" Property="Background" Value="#1E4D2B" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#66BB6A" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="White" />
                                <Setter TargetName="CostText" Property="Foreground" Value="#A5D6A7" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Planned">
                                <Setter TargetName="Box" Property="Background" Value="#123A5C" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4FC3F7" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="White" />
                                <Setter TargetName="CostText" Property="Foreground" Value="#81D4FA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Available">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#B0BEC5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="1" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFB74D" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2.5" />
                                <Setter TargetName="Box" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12,10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Clear plan" Command="{Binding ClearPlanCommand}" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" FontSize="12" />
                <TextBlock Style="{StaticResource Note}" FontSize="12"
                           Text="Click a node to plan it (the nodes it needs come along); click a planned node to drop it. Plans are kept per save." />
            </StackPanel>
        </DockPanel>

        <!-- The selected node: what it costs, needs and unlocks. -->
        <Border DockPanel.Dock="Right" Width="270" Margin="10,0,0,0" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock Text="Pick a node to see its parts.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0">
                            <Run Text="{Binding Selected.StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.CostText, Mode=OneWay}" /><Run Text=" science" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedNeeds}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Selected.Node.Description}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Parts" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                        <ItemsControl ItemsSource="{Binding SelectedParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding StatusText, Mode=OneWay}" FontStyle="Italic"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Facts}" Style="{StaticResource Note}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border CornerRadius="6" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0B101E">
                <Grid Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Path Data="{Binding Links}" Stroke="#46526E" StrokeThickness="1.5" />
                    <Path Data="{Binding PlannedLinks}" Stroke="#4FC3F7" StrokeThickness="2.5" />
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NodeButton}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
