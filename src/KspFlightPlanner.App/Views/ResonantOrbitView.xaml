<UserControl x:Class="KspFlightPlanner.App.Views.ResonantOrbitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:KspFlightPlanner.App"
             xmlns:controls="clr-namespace:KspFlightPlanner.App.Controls">
    <Grid Margin="8,10,8,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Inputs and results -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="16,12,8,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,18,0">
                    <!-- Planning the deployment at a mission stop: body and orbit come from the stop -->
                    <Border Margin="0,0,0,10" Padding="10,8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingLeg}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Deployment at a mission stop" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LegTitle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Note}" TextWrapping="Wrap" Margin="0,4,0,6"
                                       Text="The satellite count and orbit choices here are saved with the mission. The carrier's burns count toward the rocket; each satellite circularizes with its own engine." />
                            <Button Content="Stop editing the stop" Command="{Binding StopEditingLegCommand}" HorizontalAlignment="Left" Padding="8,1"
                                    ToolTip="Use the calculator on its own again; the mission keeps this deployment" />
                        </StackPanel>
                    </Border>

                    <!-- The deployment being planned; its inputs live in the Calculators pane -->
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Change…" Padding="8,1" VerticalAlignment="Center"
                                Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Calculators}"
                                ToolTip="Edit the deployment in the Calculators pane" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Run Text="{Binding SelectedBody.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run
                                 Text="{Binding SatelliteCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" satellites" />
                        </TextBlock>
                    </DockPanel>

                    <TextBlock Text="{Binding ErrorText}" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="Carrier orbit" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Target orbit period" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SatellitePeriodText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Text="Type" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrbitTypeText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="2" Text="Carrier period" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CarrierPeriodText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="3" Text="Apoapsis" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CarrierApoapsisText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="4" Text="Periapsis" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CarrierPeriapsisText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="5" Text="Injection Δv" Style="{StaticResource Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InjectionDeltaVText}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="#FFA726" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Fly this deployment" Command="{Binding FlyCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,3"
                            ToolTip="Open it on the Flight tab: the carrier's burn and each satellite's circularize burn, timed from your carrier's real orbit (KSP Stock bodies)" />

                    <TextBlock Text="Body data" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Equatorial radius" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BodyRadiusText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Text="μ (GM)" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BodyMuText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="2" Text="Atmosphere" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BodyAtmosphereText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="3" Text="Sidereal day" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BodyRotationText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="4" Text="Synchronous orbit" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SynchronousAltitudeText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="5" Text="Min. line-of-sight" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MinimumLineOfSightText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="6" Text="Sphere of influence" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SoiAltitudeText}" Style="{StaticResource Value}" />
                    </Grid>

                    <TextBlock Text="Saved plans" Style="{StaticResource SectionHeader}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SavePlanCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Plan name" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding SavedPlans}" SelectedItem="{Binding SelectedPlan}" Height="140" Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11">
                                        <Run Text="{Binding BodyName, Mode=OneWay}" /> · <Run Text="{Binding SatelliteCount, Mode=OneWay}" /> sats · <Run Text="{Binding AltitudeM, Mode=OneWay, StringFormat=N0}" /> m
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Load" Command="{Binding LoadPlanCommand}" Margin="0,0,8,0" />
                        <Button Content="Delete" Command="{Binding DeletePlanCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Diagram -->
        <Border Grid.Column="2" CornerRadius="8" ClipToBounds="True">
            <controls:OrbitDiagram Body="{Binding SelectedBody}"
                                   Result="{Binding Result}"
                                   SatelliteCount="{Binding SatelliteCount}"
                                   MinimumLineOfSightAltitude="{Binding MinimumLineOfSightAltitude}"
                                   ShowLineOfSight="{Binding ShowLineOfSight}" />
        </Border>
    </Grid>
</UserControl>
