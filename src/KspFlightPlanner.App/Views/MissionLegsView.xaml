<UserControl x:Class="KspFlightPlanner.App.Views.MissionLegsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="PhaseChoice">
            <StackPanel Orientation="Horizontal">
                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="16,0,0,10" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,14,18,0" Grid.IsSharedSizeScope="True">
            <TextBlock Text="{Binding RouteSummary}" Style="{StaticResource Note}" Margin="0,0,0,8" />

            <!-- Column headers -->
            <Grid Margin="0,0,0,4" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontWeight="SemiBold">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" MinWidth="190" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Dv" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Plane" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Aero" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Eff" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" />
                <TextBlock Grid.Column="1" Text="Leg" />
                <TextBlock Grid.Column="2" Text="Map Δv (editable)" Margin="8,0" />
                <TextBlock Grid.Column="3" Text="Plane chg." Margin="8,0" />
                <TextBlock Grid.Column="4" Text="Aerobrake" Margin="8,0" />
                <TextBlock Grid.Column="5" Text="Δv needed" Margin="8,0" />
                <TextBlock Grid.Column="6" Text="Phase" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Legs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding SectionHeader}" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap"
                                       Visibility="{Binding HasSectionHeader, Converter={StaticResource BoolToVisibility}}" />
                            <Border BorderThickness="0,0,0,1" BorderBrush="#30808080" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" MinWidth="190" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Dv" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Plane" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Aero" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Eff" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ToText}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Note}">
                                            <Run Text="from " /><Run Text="{Binding FromText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Note}" />
                                    </StackPanel>
                                    <TextBox x:Name="DvBox" Grid.Column="2" Text="{Binding DvText, Mode=TwoWay}" Width="72" Margin="8,0"
                                             TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding DvToolTip}" IsReadOnly="{Binding IsFromTool, Mode=OneWay}"
                                             FontFamily="Cascadia Mono, Consolas" />
                                    <CheckBox Grid.Column="3" Content="{Binding PlaneChangeText}" IsChecked="{Binding IncludePlaneChange}"
                                              Visibility="{Binding HasPlaneChange, Converter={StaticResource BoolToVisibility}}"
                                              Margin="8,0" VerticalAlignment="Center" ToolTip="Add the map's worst-case plane change for this leg" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding UseAerobrake}"
                                              Visibility="{Binding CanAerobrake, Converter={StaticResource BoolToVisibility}}"
                                              Margin="8,0" VerticalAlignment="Center" ToolTip="Use the atmosphere instead of a burn" />
                                    <TextBlock Grid.Column="5" Text="{Binding EffectiveText}" Style="{StaticResource Value}" FontWeight="SemiBold" Margin="8,0" />
                                    <ComboBox Grid.Column="6" VerticalAlignment="Center"
                                              ItemsSource="{Binding DataContext.Phases, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Phase}" ItemTemplate="{StaticResource PhaseChoice}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFromTool}" Value="True">
                                <Setter TargetName="DvBox" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="DvBox" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                <Setter TargetName="DvBox" Property="Foreground" Value="#FFB74D" />
                                <Setter TargetName="DvBox" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,18,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Add phase" Command="{Binding AddPhaseCommand}" Margin="0,0,8,0" />
                    <Button Content="Reset to defaults" Command="{Binding ResetPhasesCommand}" />
                </StackPanel>
                <TextBlock Text="Phases" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                       Text="Each phase is a part of the rocket that must supply the Δv of its legs. Margin % is added to the phase's Δv; Extra is fixed wiggle room (e.g. landing assist)." />

            <Grid Margin="0,0,0,4" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontWeight="SemiBold">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Name" />
                <TextBlock Grid.Column="2" Text="Margin %" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="Extra (m/s)" Margin="8,0,0,0" />
                <TextBlock Grid.Column="4" Text="Legs need" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Margin" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="6" Text="Phase total" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Phases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Color}" HorizontalAlignment="Left" />
                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Text="{Binding MarginPercent, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="8,0,0,0" />
                            <TextBox Grid.Column="3" Text="{Binding ExtraDv, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="4" Text="{Binding RequiredText}" Style="{StaticResource Value}" />
                            <TextBlock Grid.Column="5" Text="{Binding MarginText}" Style="{StaticResource Value}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="6" Text="{Binding TotalText}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                            <Button Grid.Column="7" Content="✕" Padding="6,2" HorizontalAlignment="Right" ToolTip="Remove phase (its legs move to the previous phase)"
                                    Command="{Binding DataContext.RemovePhaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
