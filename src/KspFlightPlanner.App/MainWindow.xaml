<Window x:Class="KspFlightPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KspFlightPlanner.App.Views"
        xmlns:app="clr-namespace:KspFlightPlanner.App"
        Title="KSP Flight Planner"
        Width="1480" Height="920" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource ControlContentThemeFontSize}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static app:MainCommands.ImportVessels}" Executed="Import_Executed" CanExecute="HasSave_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.ReloadSave}" Executed="Reload_Executed" CanExecute="HasSaveChosen_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.ReadPartData}" Executed="ReadPartData_Executed" CanExecute="HasSaveChosen_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.OpenDataFolder}" Executed="OpenDataFolder_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.ConnectKsp}" Executed="ConnectKsp_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.Settings}" Executed="Settings_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.ShowTab}" Executed="ShowTab_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.About}" Executed="About_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Exit_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="6" />
        <KeyBinding Key="F1" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="6" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Vessels from Save…" Command="{x:Static app:MainCommands.ImportVessels}" />
                <MenuItem Header="_Reload Save" Command="{x:Static app:MainCommands.ReloadSave}" />
                <Separator />
                <MenuItem Header="Open _Data Folder" Command="{x:Static app:MainCommands.OpenDataFolder}"
                          ToolTip="Where the planner database is stored" />
                <Separator />
                <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Mission Builder" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="0" InputGestureText="Ctrl+1" />
                <MenuItem Header="_Locations" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="1" InputGestureText="Ctrl+2" />
                <MenuItem Header="_Vessels" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="2" InputGestureText="Ctrl+3" />
                <MenuItem Header="_Transfer Planner" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="3" InputGestureText="Ctrl+4" />
                <MenuItem Header="Re_ndezvous" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="4" InputGestureText="Ctrl+5" />
                <MenuItem Header="_Resonant Orbits" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="5" InputGestureText="Ctrl+6" />
                <MenuItem Header="Math _Guide" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="6" InputGestureText="Ctrl+7" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="{Binding Link.MenuText}" Command="{x:Static app:MainCommands.ConnectKsp}"
                          ToolTip="Talk to the running game through the kRPC mod (address and ports in Settings › Live connection)" />
                <Separator />
                <MenuItem Header="Read _Part Data Again" Command="{x:Static app:MainCommands.ReadPartData}"
                          ToolTip="Read part masses, engines and antennas from the KSP folder again" />
                <Separator />
                <MenuItem Header="_Settings…" Command="{x:Static app:MainCommands.Settings}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Math _Guide" Command="{x:Static app:MainCommands.ShowTab}" CommandParameter="6" InputGestureText="F1" />
                <Separator />
                <MenuItem Header="_About KSP Flight Planner" Command="{x:Static app:MainCommands.About}" />
            </MenuItem>
        </Menu>

        <!-- KSP save link: what was read, when, and whether it's being watched. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="8,0">
            <StatusBarItem ToolTip="{Binding Sync.PersistentPath}">
                <TextBlock Text="{Binding Sync.Status}" FontSize="12" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding Sync.HasProblem, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Sync.Problem}" Foreground="#EF5350" FontSize="12" />
            </StatusBarItem>
            <!-- Right side: vessels waiting to be imported, then the live link to the game. -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Margin="0,0,16,0" Visibility="{Binding Sync.HasNewVessels, Converter={StaticResource BoolToVisibility}}">
                        <Hyperlink Command="{x:Static app:MainCommands.ImportVessels}" ToolTip="File › Import Vessels from Save…">
                            <Run Text="{Binding Sync.NewVesselsText, Mode=OneWay}" /><Run Text=" to import" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Link.Problem}" Foreground="#EF5350" FontSize="12" Margin="0,0,12,0" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#808080" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Link.State}" Value="Connecting">
                                        <Setter Property="Fill" Value="#FFB300" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Link.State}" Value="Connected">
                                        <Setter Property="Fill" Value="#66BB6A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12">
                        <Hyperlink Command="{x:Static app:MainCommands.ConnectKsp}" ToolTip="{Binding Link.MenuText}">
                            <Run Text="{Binding Link.Status, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8,6,8,6" SelectedIndex="{Binding SelectedTab}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <TabItem Header="Mission Builder">
                <views:MissionBuilderView DataContext="{Binding Mission}" />
            </TabItem>
            <TabItem Header="Locations">
                <views:LocationsView DataContext="{Binding Locations}" />
            </TabItem>
            <TabItem Header="Vessels">
                <views:VesselsView DataContext="{Binding Vessels}" />
            </TabItem>
            <TabItem Header="Transfer Planner">
                <views:TransferPlannerView DataContext="{Binding Transfer}" />
            </TabItem>
            <TabItem Header="Rendezvous">
                <views:RendezvousView DataContext="{Binding Rendezvous}" />
            </TabItem>
            <TabItem Header="Resonant Orbits">
                <views:ResonantOrbitView DataContext="{Binding Resonant}" />
            </TabItem>
            <TabItem Header="Math Guide">
                <views:GuideView />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
