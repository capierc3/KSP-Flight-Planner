<Window x:Class="KspFlightPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KspFlightPlanner.App.Views"
        Title="KSP Flight Planner"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8,4,8,8">
        <TabItem Header="Transfer planner">
            <views:TransferPlannerView DataContext="{Binding Transfer}" />
        </TabItem>
        <TabItem Header="Resonant orbits">
            <views:ResonantOrbitView DataContext="{Binding Resonant}" />
        </TabItem>
    </TabControl>
</Window>
