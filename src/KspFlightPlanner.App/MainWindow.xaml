<Window x:Class="KspFlightPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KspFlightPlanner.App.Views"
        Title="KSP Flight Planner"
        Width="1480" Height="920" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
    <TabControl Margin="12,8,12,12" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="Mission builder">
            <views:MissionBuilderView DataContext="{Binding Mission}" />
        </TabItem>
        <TabItem Header="Locations">
            <views:LocationsView DataContext="{Binding Locations}" />
        </TabItem>
        <TabItem Header="Transfer planner">
            <views:TransferPlannerView DataContext="{Binding Transfer}" />
        </TabItem>
        <TabItem Header="Resonant orbits">
            <views:ResonantOrbitView DataContext="{Binding Resonant}" />
        </TabItem>
        <TabItem Header="Math guide">
            <views:GuideView />
        </TabItem>
    </TabControl>

    <!-- KSP save link: status, import and settings, at the right of the tab strip. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0">
        <TextBlock Text="{Binding Sync.Status}" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,10,0"
                   ToolTip="{Binding Sync.PersistentPath}" />
        <TextBlock Text="{Binding Sync.Problem}" Foreground="#EF5350" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"
                   Visibility="{Binding Sync.HasProblem, Converter={StaticResource BoolToVisibility}}" />
        <Button Content="↻" ToolTip="Read the save again now" Click="Reload_Click" Margin="0,0,6,0" Padding="8,2"
                Visibility="{Binding Sync.HasSave, Converter={StaticResource BoolToVisibility}}" />
        <Button Click="Import_Click" Margin="0,0,6,0" Padding="10,2" ToolTip="Add vessels from your KSP save as custom locations"
                Visibility="{Binding Sync.HasSave, Converter={StaticResource BoolToVisibility}}">
            <TextBlock><Run Text="Import vessels…" /><Run Text="{Binding Sync.NewVesselsText, Mode=OneWay, StringFormat='  ({0})'}" /></TextBlock>
        </Button>
        <Button Content="⚙ Settings" Click="Settings_Click" Padding="10,2" />
    </StackPanel>
    </Grid>
</Window>
