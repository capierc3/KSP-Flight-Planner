<Window x:Class="KspFlightPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KspFlightPlanner.App"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        Icon="/Assets/app.ico"
        Title="{Binding Mission.WindowTitle, FallbackValue='KSP Flight Planner'}"
        Width="1480" Height="920" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource ControlContentThemeFontSize}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Plan / Fly switch: two toggle buttons side by side -->
        <Style x:Key="ModeButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="14,2,14,3" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="GroupName" Value="Mode" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static app:MainCommands.ImportVessels}" Executed="Import_Executed" CanExecute="HasSave_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.ReloadSave}" Executed="Reload_Executed" CanExecute="HasSaveChosen_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.ReadPartData}" Executed="ReadPartData_Executed" CanExecute="HasSaveChosen_CanExecute" />
        <CommandBinding Command="{x:Static app:MainCommands.OpenDataFolder}" Executed="OpenDataFolder_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.ConnectKsp}" Executed="ConnectKsp_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.BakeSurface}" Executed="BakeSurface_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.Settings}" Executed="Settings_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.ShowPane}" Executed="ShowPane_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.SetMode}" Executed="SetMode_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.ResetLayout}" Executed="ResetLayout_Executed" />
        <CommandBinding Command="{x:Static app:MainCommands.About}" Executed="About_Executed" />
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Exit_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static app:MainCommands.SetMode}" CommandParameter="Plan" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static app:MainCommands.SetMode}" CommandParameter="Fly" />
        <KeyBinding Key="F1" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Guide}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Mission.NewMissionCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Missions}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Mission.SaveMissionCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding Mission.SaveMissionAsCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <!-- Plan / Fly: each mode keeps its own arrangement of panes -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                <RadioButton Content="Plan" Style="{StaticResource ModeButton}" IsChecked="{Binding IsPlanning}"
                             ToolTip="Plan missions (Ctrl+1)" />
                <RadioButton Content="Fly" Style="{StaticResource ModeButton}" IsChecked="{Binding IsFlying}" Margin="4,0,0,0"
                             ToolTip="Fly a plan against the live game (Ctrl+2)" />
            </StackPanel>

            <Menu Padding="4,2">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Mission" Command="{Binding Mission.NewMissionCommand}" InputGestureText="Ctrl+N" />
                    <MenuItem Header="_Open Mission…" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Missions}"
                              InputGestureText="Ctrl+O" ToolTip="Saved missions are listed in the Saved missions pane" />
                    <MenuItem Header="_Save Mission" Command="{Binding Mission.SaveMissionCommand}" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Save Mission _As…" Command="{Binding Mission.SaveMissionAsCommand}" InputGestureText="Ctrl+Shift+S"
                              ToolTip="Save a copy and keep editing the copy" />
                    <Separator />
                    <MenuItem Header="_Import Vessels from Save…" Command="{x:Static app:MainCommands.ImportVessels}" />
                    <MenuItem Header="_Reload Save" Command="{x:Static app:MainCommands.ReloadSave}" />
                    <Separator />
                    <MenuItem Header="Open _Data Folder" Command="{x:Static app:MainCommands.OpenDataFolder}"
                              ToolTip="Where the planner database is stored" />
                    <Separator />
                    <MenuItem Header="E_xit" Command="{x:Static ApplicationCommands.Close}" InputGestureText="Alt+F4" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Plan" Command="{x:Static app:MainCommands.SetMode}" CommandParameter="Plan" InputGestureText="Ctrl+1"
                              IsChecked="{Binding IsPlanning, Mode=OneWay}" />
                    <MenuItem Header="_Fly" Command="{x:Static app:MainCommands.SetMode}" CommandParameter="Fly" InputGestureText="Ctrl+2"
                              IsChecked="{Binding IsFlying, Mode=OneWay}" />
                    <Separator />
                    <MenuItem Header="_Mission" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Mission}" />
                    <MenuItem Header="_Saved missions" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Missions}" />
                    <MenuItem Header="_Calculators" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Calculators}" />
                    <MenuItem Header="Not_es" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Notes}" />
                    <MenuItem Header="_Rocket" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Rocket}" />
                    <MenuItem Header="P_arts" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Parts}" />
                    <MenuItem Header="Part _details" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Part}" />
                    <MenuItem Header="_Locations" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Locations}" />
                    <MenuItem Header="_Vessels" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Vessels}" />
                    <MenuItem Header="F_lights" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Flights}" />
                    <MenuItem Header="From _here" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.FromHere}" />
                    <Separator />
                    <MenuItem Header="Legs &amp; p_hases" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Legs}" />
                    <MenuItem Header="Δv m_ap" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.DvMap}" />
                    <MenuItem Header="_Transfer Planner" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Transfer}" />
                    <MenuItem Header="Re_ndezvous" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Rendezvous}" />
                    <MenuItem Header="Res_onant Orbits" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Resonant}" />
                    <MenuItem Header="Te_ch tree" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.TechTree}" />
                    <MenuItem Header="_Engineering" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Engineering}" />
                    <MenuItem Header="Fli_ght" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Flight}" />
                    <Separator />
                    <MenuItem Header="Reset Window _Layout" Command="{x:Static app:MainCommands.ResetLayout}"
                              ToolTip="Put the panes of the current mode back where they started" />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="{Binding Link.MenuText}" Command="{x:Static app:MainCommands.ConnectKsp}"
                              ToolTip="Talk to the running game through the kRPC mod (address and ports in Settings › Live connection)" />
                    <MenuItem Header="_Bake Surface Data…" Command="{x:Static app:MainCommands.BakeSurface}"
                              ToolTip="Sample each body's terrain, biomes, rotation and air from the running game, for landing spots" />
                    <Separator />
                    <MenuItem Header="Read _Part Data Again" Command="{x:Static app:MainCommands.ReadPartData}"
                              ToolTip="Read part masses, engines and antennas from the KSP folder again" />
                    <Separator />
                    <MenuItem Header="_Settings…" Command="{x:Static app:MainCommands.Settings}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Math _Guide" Command="{x:Static app:MainCommands.ShowPane}" CommandParameter="{x:Static app:Panes.Guide}" InputGestureText="F1" />
                    <Separator />
                    <MenuItem Header="_About KSP Flight Planner" Command="{x:Static app:MainCommands.About}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- KSP save link: what was read, when, and whether it's being watched. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="8,0">
            <StatusBarItem ToolTip="{Binding Sync.PersistentPath}">
                <TextBlock Text="{Binding Sync.Status}" FontSize="12" />
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding Sync.HasProblem, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Sync.Problem}" Foreground="#EF5350" FontSize="12" />
            </StatusBarItem>
            <!-- Right side: vessels waiting to be imported, then the live link to the game. -->
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Margin="0,0,16,0" Visibility="{Binding Sync.HasNewVessels, Converter={StaticResource BoolToVisibility}}">
                        <Hyperlink Command="{x:Static app:MainCommands.ImportVessels}" ToolTip="File › Import Vessels from Save…">
                            <Run Text="{Binding Sync.NewVesselsText, Mode=OneWay}" /><Run Text=" to import" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Link.Problem}" Foreground="#EF5350" FontSize="12" Margin="0,0,12,0" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#808080" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Link.State}" Value="Connecting">
                                        <Setter Property="Fill" Value="#FFB300" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Link.State}" Value="Connected">
                                        <Setter Property="Fill" Value="#66BB6A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12">
                        <Hyperlink Command="{x:Static app:MainCommands.ConnectKsp}" ToolTip="{Binding Link.ToolTipText}">
                            <Run Text="{Binding Link.Status, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- One docking area per mode; panes can be dragged between the sides, split, tabbed together or floated. -->
        <Grid>
            <ad:DockingManager x:Name="PlanDock" Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVisibility}}" />
            <ad:DockingManager x:Name="FlyDock" Visibility="{Binding IsFlying, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
