<Window x:Class="KspFlightPlanner.App.ImportVesselsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import vessels from KSP" Width="1060" Height="640" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Header}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Subheader}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,10"
                       Text="Each vessel you import becomes a placed custom location linked to the vessel: its orbit follows the save whenever KSP writes it. You can rename it, add a description and images — those stay yours. Only closed orbits can be imported." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding ImportText}" Command="{Binding ImportCommand}" IsDefault="True" MinWidth="140" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" MinWidth="90" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontWeight="SemiBold" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" /><ColumnDefinition Width="230" /><ColumnDefinition Width="130" />
                <ColumnDefinition Width="90" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Vessel" /><TextBlock Grid.Column="2" Text="Type" /><TextBlock Grid.Column="3" Text="Orbiting" />
            <TextBlock Grid.Column="4" Text="Pe × Ap, inclination" /><TextBlock Grid.Column="5" Text="Status" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="#30808080" Padding="0,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" /><ColumnDefinition Width="230" /><ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" MinWidth="0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Orbiting}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Orbit}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
