<Window x:Class="KspFlightPlanner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <TextBlock Text="Kerbal Space Program" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Note}"
                   Text="The planner reads your save to place your vessels as custom locations. It only reads KSP's files — it never changes them." />

        <TextBlock Text="KSP folder" Style="{StaticResource Label}" Margin="0,14,12,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Detect" Command="{Binding DetectCommand}" Margin="8,0,0,0"
                    ToolTip="Look for KSP in your Steam libraries" />
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
        </DockPanel>
        <TextBlock Text="{Binding InstallProblem}" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,4,0,0" />

        <TextBlock Text="Save" Style="{StaticResource Label}" />
        <ComboBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" />
        <TextBlock Text="{Binding SaveDetails}" Style="{StaticResource Note}" Margin="0,4,0,0" />

        <CheckBox Content="Keep linked locations up to date while I play (watch the save file)" IsChecked="{Binding WatchSave}" Margin="0,14,0,0" />
        <TextBlock Style="{StaticResource Note}" Margin="24,4,0,0"
                   Text="KSP writes the save when you go back to the Space Center, Tracking Station or VAB, on launch and recovery, and on its autosave (every few minutes) — not continuously during a flight. Quicksaves (F5) go to a different file." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
