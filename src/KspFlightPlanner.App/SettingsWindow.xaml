<Window x:Class="KspFlightPlanner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="820" Height="500" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="{DynamicResource ControlContentThemeFontSize}">
    <Window.Resources>
        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- OK / Cancel along the bottom, as in a Windows options dialog. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#30808080" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" MinWidth="88" Click="Ok_Click" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" MinWidth="88" />
            </StackPanel>
        </Border>

        <!-- Categories on the left; each new group of options becomes another entry. -->
        <Border DockPanel.Dock="Left" Width="200" BorderThickness="0,0,1,0" BorderBrush="#30808080">
            <ListBox x:Name="Categories" SelectedIndex="0" BorderThickness="0" Background="Transparent" Margin="6,8">
                <ListBoxItem Content="Kerbal Space Program" />
            </ListBox>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,14">
            <!-- Kerbal Space Program -->
            <StackPanel>
                <TextBlock Text="Kerbal Space Program" Style="{StaticResource PageHeader}" />
                <TextBlock Style="{StaticResource Note}"
                           Text="Your save is read to place vessels as custom locations (File › Import Vessels from Save). KSP's files are only read, never changed." />

                <TextBlock Text="Installation folder" Style="{StaticResource Field}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Detect" Command="{Binding DetectCommand}" Margin="6,0,0,0" MinWidth="72"
                            ToolTip="Look for KSP in your Steam libraries" />
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0" MinWidth="72" />
                    <TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </DockPanel>
                <TextBlock Text="{Binding InstallProblem}" Foreground="#EF5350" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" />

                <TextBlock Text="Save" Style="{StaticResource Field}" />
                <ComboBox ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}" />
                <TextBlock Text="{Binding SaveDetails}" Style="{StaticResource Note}" Margin="0,4,0,0" />

                <CheckBox Content="Keep linked locations up to date while playing (watch the save file)" IsChecked="{Binding WatchSave}" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource Note}" Margin="28,4,0,0"
                           Text="KSP writes the save when you return to the Space Center, Tracking Station or VAB, on launch and recovery, and on autosave (every few minutes) — not continuously during flight. Quicksaves (F5 in game) go to a different file." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
