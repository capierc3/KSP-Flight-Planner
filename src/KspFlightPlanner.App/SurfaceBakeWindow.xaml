<Window x:Class="KspFlightPlanner.App.SurfaceBakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bake surface data from KSP" Width="760" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontSize="{DynamicResource ControlContentThemeFontSize}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="24,16,24,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Bake surface data" FontSize="18" FontWeight="Bold" />
            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Asks the running game for each body's terrain height and biome on a latitude/longitude grid, its rotation at UT 0 and its air. The planner then knows the ground height of any landing spot and the terrain along the approach. It's kept with your KSP install's data, so you only need to bake again after changing planet mods." />
            <TextBlock Text="{Binding ConnectionText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Progress and buttons -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="8" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Note}" Margin="0,4,0,0" />
            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartCommand}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,0" />
                    <Button Content="Close" IsCancel="True" MinWidth="90" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Grid" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Steps}" SelectedItem="{Binding Step}" IsEnabled="{Binding IsIdle}" MinWidth="260" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,12,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                        <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
                    </StackPanel>
                    <TextBlock Text="Bodies" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bodies}" IsEnabled="{Binding IsIdle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" Width="160" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="Log" FontWeight="SemiBold" Margin="0,10,0,4" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Log}" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
