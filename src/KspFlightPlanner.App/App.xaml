<Application x:Class="KspFlightPlanner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:KspFlightPlanner.App.ViewModels"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 Fluent styling; follows the system light/dark setting. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Denser, more technical sizing than Fluent's defaults (14 px text, 32 px controls). -->
            <sys:Double x:Key="ControlContentThemeFontSize">13</sys:Double>
            <sys:Double x:Key="ContentControlFontSize">13</sys:Double>
            <sys:Double x:Key="TreeViewItemFontSize">13</sys:Double>
            <sys:Double x:Key="BodyTextBlockFontSize">13</sys:Double>
            <sys:Double x:Key="TextControlThemeMinHeight">26</sys:Double>
            <sys:Double x:Key="ComboBoxMinHeight">26</sys:Double>
            <Thickness x:Key="TextControlThemePadding">8,3,6,4</Thickness>
            <Thickness x:Key="ButtonPadding">10,3,10,4</Thickness>
            <Thickness x:Key="ComboBoxPadding">10,3,0,4</Thickness>
            <Thickness x:Key="ToggleButtonPadding">10,3,10,4</Thickness>

            <!-- Flat document tabs (Visual Studio style) for every tab strip: accent underline on the open tab. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                    Padding="12,4" Margin="0,0,1,0">
                                <ContentPresenter x:Name="Header" ContentSource="Header" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14808080" />
                                    <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#22808080" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                    <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text uses the theme's primary / secondary colours (not opacity), so it stays readable in light and dark. -->
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,20,0,8" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,6,12,3" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Label/value pairs; values are selectable so they can be copied. -->
            <DataTemplate x:Key="FactRow" DataType="{x:Type vm:Fact}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,0,16,0" />
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Padding="0" MinHeight="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- A bordered area that groups one part of a screen (tree, detail, inputs…). -->
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
